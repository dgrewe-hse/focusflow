{
  "name": "vue-focusflow",
  "version": "1.0.0",
  "description": "A frontend for the FocusFlow project",
  "author": "Dennis Grewe",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "vite --port 8081",
    "serve": "vite --port 8081",
    "build": "vite build",
    "preview": "vite preview",
    "test": "./cypress-runner.sh open",
    "test:headless": "./cypress-runner.sh run",
    "test:auth": "npx cypress run --spec 'cypress/e2e/auth/**'",
    "test:e2e": "npx cypress run --spec 'cypress/e2e/e2e/**'",
    "test:tasks": "npx cypress run --spec 'cypress/e2e/tasks/**'",
    "test:selenium": "./run-selenium-tests.sh all",
    "test:selenium:auth": "./run-selenium-tests.sh auth",
    "test:selenium:tasks": "./run-selenium-tests.sh tasks",
    "test:selenium:integration": "./run-selenium-tests.sh integration",
    "test:selenium:headless": "HEADLESS=true ./run-selenium-tests.sh all",
    "test:selenium:chrome": "BROWSER=chrome ./run-selenium-tests.sh all",
    "test:selenium:firefox": "BROWSER=firefox ./run-selenium-tests.sh all"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vue/cli": "^4.2.2",
    "axios": "^1.6.7",
    "material-design-icons-iconfont": "^6.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.2.5",
    "vuetify": "^3.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/cli-service": "^5.0.8",
    "cypress": "^14.4.0",
    "vite": "^6.3.5",
    "selenium-webdriver": "^4.21.0",
    "chromedriver": "^125.0.1",
    "geckodriver": "^4.4.0",
    "mocha": "^10.6.0",
    "chai": "^5.1.1"
  }
}
